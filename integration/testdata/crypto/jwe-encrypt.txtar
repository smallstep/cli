# oct A128KW round trip
exec step crypto jwk create --no-password --insecure --kty oct --use enc --alg A128KW a128kw.pub a128kw.priv
stdin secret.txt
exec step crypto jwe encrypt --key a128kw.priv --enc A256GCM
cp stdout a128kw.jwe
stdin a128kw.jwe
exec step crypto jwe decrypt --key a128kw.priv
stdout '^secret$'

stdin secret.txt
exec step crypto jwe encrypt --key a128kw.pub --enc A256GCM
cp stdout a128kw-pub.jwe
stdin a128kw-pub.jwe
exec step crypto jwe decrypt --key a128kw.priv
stdout '^secret$'


